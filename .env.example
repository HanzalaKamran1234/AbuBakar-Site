# ==============================================================================
# AB SHOES / ABU BAKAR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administrator Authentication
# ------------------------------------------------------------------------------
# Custom password for accessing the /admin dashboard.
# (If not set, defaults to "Abubakar@2026!")
ADMIN_PASSWORD=Abubakar@2026!

# Secret key used to cryptographically sign administrator session cookies.
SESSION_SECRET=ab-shoes-luxury-atelier-session-secret-2026-key

# ------------------------------------------------------------------------------
# 2. Supabase Database & Storage (Optional but Recommended for Cloud Persistence)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> API, obtain your Project URL and API Keys:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Note: If Supabase credentials are not provided, the application automatically
# operates in resilient local fallback mode with pre-seeded data, ensuring zero downtime!
